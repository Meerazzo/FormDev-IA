# =========================
# Inference / vLLM
# =========================
MODEL_ID=Qwen/Qwen2.5-7B-Instruct-AWQ
DTYPE=auto
MAX_MODEL_LEN=8192
VLLM_PORT=8000
HF_CACHE=./.cache/huggingface

# =========================
# API
# =========================
API_PORT=8080
API_KEYS=internal-dev-key
RATE_LIMIT_RPM=60
LOG_LEVEL=INFO

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=formdev_ia
POSTGRES_USER=formdev
POSTGRES_PASSWORD=formdev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://formdev:formdev@postgres:5432/formdev_ia

# =========================
# Qdrant
# =========================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=survey_feedback_examples
QDRANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_VECTOR_SIZE=384


# =========================
# RAG documentaire
# =========================
RAG_QDRANT_COLLECTION=rag_chunks
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_VECTOR_SIZE=384
RAG_DEFAULT_TOP_K=5
RAG_SCORE_THRESHOLD=0.25
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_STORAGE_DIR=/data/rag
RQ_RAG_QUEUE=rag
# RAG queues
RQ_RAG_DEV_QUEUE=rag-dev
RQ_RAG_PROD_QUEUE=rag-prod

# RAG strict fallback
RAG_MIN_RELEVANT_SCORE=0.55
