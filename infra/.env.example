# ============================================================
# FormDev IA - Environment example
# ============================================================
# Usage:
#   cp infra/.env.example infra/.env
#   then edit secrets, ports and model settings if needed.
#
# Never commit a real .env file.

# ============================================================
# Runtime / environment
# ============================================================
APP_ENV=dev
LOG_LEVEL=INFO

# ============================================================
# API
# ============================================================
# API_KEYS supports either:
#   - a single raw key: internal-dev-key
#   - mapped keys: client_a:key_a,client_b:key_b
API_KEYS=internal-dev-key
RATE_LIMIT_RPM=60
API_DEV_PORT=8080
API_PROD_PORT=8081

# ============================================================
# Inference / vLLM
# ============================================================
MODEL_ID=Qwen/Qwen2.5-7B-Instruct-AWQ
DTYPE=auto
MAX_MODEL_LEN=8192
VLLM_PORT=8000
HF_CACHE=../.cache/huggingface
VLLM_BASE_URL=http://inference:8000

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_USER=formdev
POSTGRES_PASSWORD=formdev-change-me
POSTGRES_DEV_DB=formdev_ia_dev
POSTGRES_PROD_DB=formdev_ia_prod
POSTGRES_DEV_PORT=5432
POSTGRES_PROD_PORT=5433

# Used when running the API outside docker-compose.
# Inside docker-compose, DATABASE_URL is injected service by service.
DATABASE_URL=postgresql+psycopg2://formdev:formdev-change-me@localhost:5432/formdev_ia_dev

# ============================================================
# Qdrant - shared settings
# ============================================================
QDRANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_VECTOR_SIZE=384

# Used when running the API outside docker-compose.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=survey_feedback_examples_dev

# Docker Compose dev/prod collections and ports
QDRANT_DEV_HTTP_PORT=6333
QDRANT_DEV_GRPC_PORT=6334
QDRANT_PROD_HTTP_PORT=6335
QDRANT_PROD_GRPC_PORT=6336
QDRANT_DEV_COLLECTION=survey_feedback_examples_dev
QDRANT_PROD_COLLECTION=survey_feedback_examples_prod

# ============================================================
# Redis / RQ
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
RQ_DEFAULT_TIMEOUT=900
RQ_RESULT_TTL=86400
RQ_FAILURE_TTL=604800
RQ_SURVEY_QUEUE=survey
RQ_SURVEY_DEV_QUEUE=survey-dev
RQ_SURVEY_PROD_QUEUE=survey-prod
RQ_RAG_QUEUE=rag
RQ_RAG_DEV_QUEUE=rag-dev
RQ_RAG_PROD_QUEUE=rag-prod

# ============================================================
# Survey module
# ============================================================
SURVEY_PURGE_AFTER_FEEDBACK=false

# ============================================================
# RAG documentaire
# ============================================================
RAG_QDRANT_COLLECTION=rag_chunks
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_VECTOR_SIZE=384
RAG_DEFAULT_TOP_K=5
RAG_SCORE_THRESHOLD=0.25
RAG_MIN_RELEVANT_SCORE=0.55
RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=4
RAG_MAX_CHUNKS_PER_SOURCE=2
RAG_MAX_CONTEXT_CHARS=6000
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_STORAGE_DIR=/data/rag

# URL ingestion parser:
#   basic     = lightweight parser, easiest for local/dev
#   crawl4ai  = advanced crawler/parser, heavier dependencies
RAG_URL_PARSER_BACKEND=basic
RAG_CRAWL4AI_LIGHT_CLEANING=true

# ============================================================
# Observability / Graylog
# ============================================================
# Disabled by default. Enable only when the Graylog stack is running.
GRAYLOG_ENABLED=false
GRAYLOG_HOST=graylog
GRAYLOG_PORT=12201
GRAYLOG_FACILITY=formdev-ia
GRAYLOG_HTTP_PORT=9000
GRAYLOG_GELF_UDP_PORT=12201

# Replace these values before enabling Graylog.
GRAYLOG_PASSWORD_SECRET=change-me-change-me-change-me-change-me
# SHA-256 hash of the Graylog admin password.
GRAYLOG_ROOT_PASSWORD_SHA2=change-me-sha256-hash
